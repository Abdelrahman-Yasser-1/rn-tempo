# dependencies
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# build output
dist/
dist-web/
apps/local-backend/engine/dashboard/
coverage/
.next/
out/
*.tsbuildinfo

# OS / IDE
.DS_Store
.idea/
*.swp

# env & secrets (template/.env.dev is intentionally committed — it holds no secrets)
.env
.env.*
!.env.example
!template/.env.dev
*.keystore
!template/android/app/debug.keystore
*.jks
*.p12
*.mobileprovision

# AI session logs and pointer: local only, never committed
.ai/sessions/
.ai/.current.json
template/.ai/.current.json

# logs
*.log

# eslint-plugin-project-structure cache (written on every lint run)
projectStructure.cache.json

# desktop app (Tauri): Rust build output, generated schemas, the copied standalone dev API
apps/*/src-tauri/target/
apps/*/src-tauri/gen/
apps/*/src-tauri/resources/
apps/local-backend/engine/.kit-stage/
# code-review-graph: local code graph for AI tools (see AGENTS.md)
.code-review-graph/
