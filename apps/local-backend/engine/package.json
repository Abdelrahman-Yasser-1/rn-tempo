{
  "name": "@rn-tempo/local-backend",
  "version": "0.0.0",
  "description": "Tempo Local Backend: serve a backend folder (JSON definition, SQLite) as a real API, and manage several of them from a web dashboard. Run with npx @rn-tempo/local-backend.",
  "keywords": [
    "mock-api",
    "local-backend",
    "react-native",
    "sqlite",
    "openapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-Yasser-1/rn-tempo.git",
    "directory": "apps/local-backend/engine"
  },
  "type": "module",
  "bin": {
    "tempo-local-backend": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "dashboard",
    "schemas",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/test-kit/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "default": "./dist/index.mjs"
      },
      "./test": {
        "import": {
          "types": "./dist/test.d.mts",
          "default": "./dist/test.mjs"
        },
        "require": {
          "types": "./dist/test.d.cts",
          "default": "./dist/test.cjs"
        }
      }
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "schema": "node scripts/write-schema.ts",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "node scripts/build-dashboard.ts",
    "build:sea": "node scripts/build-sea.ts",
    "smoke:sea": "node scripts/smoke-sea.ts",
    "prepack": "npm run build:dashboard && npm run build",
    "test:kit": "node scripts/run-kit-fixture.ts"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "graphql": "17.1.0",
    "pino": "10.4.0",
    "swagger-ui-dist": "5.34.1",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rn-tempo/api-contract": "workspace:*",
    "@rn-tempo/dev-api": "workspace:*",
    "@rn-tempo/tsconfig": "workspace:*",
    "@types/busboy": "1.5.5",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "axios": "1.20.0",
    "jest": "30.5.2",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
