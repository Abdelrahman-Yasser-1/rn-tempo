{
  "swagger": "2.0",
  "info": { "title": "Pet Shop", "version": "1.0.0" },
  "host": "api.petshop.test",
  "basePath": "/v2",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "bearer": { "type": "apiKey", "in": "header", "name": "Authorization" },
    "legacyKey": { "type": "apiKey", "in": "query", "name": "api_key" }
  },
  "parameters": {
    "limitParam": { "name": "limit", "in": "query", "type": "integer", "minimum": 1, "maximum": 50, "description": "How many pets" },
    "petBody": { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/NewPet" } }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64", "minimum": 1 },
        "name": { "type": "string", "example": "Rex" },
        "tag": { "type": "string", "x-nullable": true },
        "owner": { "$ref": "#/definitions/Owner" }
      }
    },
    "NewPet": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 2 }, "tag": { "type": "string" } }
    },
    "Owner": {
      "type": "object",
      "properties": { "email": { "type": "string", "format": "email" }, "uuid": { "type": "string", "format": "uuid" } }
    },
    "Error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" } } }
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "tags": ["pets"],
        "parameters": [{ "$ref": "#/parameters/limitParam" }],
        "responses": {
          "200": { "description": "A list of pets", "schema": { "type": "array", "items": { "$ref": "#/definitions/Pet" } }, "examples": { "application/json": [{ "id": 1, "name": "Rex" }] } },
          "default": { "description": "Unexpected error", "schema": { "$ref": "#/definitions/Error" } }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["pets"],
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/parameters/petBody" }],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Pet" } },
          "422": { "description": "Validation failed", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [{ "name": "petId", "in": "path", "required": true, "type": "integer" }],
      "get": {
        "summary": "One pet",
        "tags": ["pets"],
        "responses": {
          "200": { "description": "The pet", "schema": { "$ref": "#/definitions/Pet" } },
          "404": { "description": "Not found", "schema": { "$ref": "#/definitions/Error" } }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "tags": ["pets"],
        "parameters": [{ "name": "X-Reason", "in": "header", "type": "string" }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/pets/{petId}/photo": {
      "post": {
        "operationId": "uploadPhoto",
        "tags": ["photos"],
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer" },
          { "name": "file", "in": "formData", "type": "file", "required": true }
        ],
        "responses": { "200": { "description": "OK", "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" } } } } }
      }
    }
  }
}
