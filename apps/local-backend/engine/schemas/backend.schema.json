      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "port": {
      "default": 8443,
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "https": {
      "default": true,
      "type": "boolean"
    },
    "basePath": {
      "description": "Mounted in front of every endpoint path.",
      "type": "string",
      "pattern": "^(\\/[A-Za-z0-9._~-]+)*$"
    },
    "certsDir": {
      "description": "Folder with cert.pem and key.pem. Defaults to `.data/certs`.",
      "type": "string"
    },
    "auth": {
      "default": {
        "accessTtlMin": 30,
        "refreshTtlDays": 30,
        "otpCode": "123456",
        "otpResendSec": 60,
        "seedUsers": []
      },
      "type": "object",
      "properties": {
        "accessTtlMin": {
          "default": 30,
          "description": "Access token lifetime in minutes.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 525600
        },
        "refreshTtlDays": {
          "default": 30,
          "description": "Refresh token lifetime in days.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3650
        },
        "otpCode": {
          "default": "123456",
          "description": "The one-time code `otpVerify` accepts.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "otpResendSec": {
          "default": 60,
          "description": "The `retryAfterSec` that `otpResend` answers.",
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "seedUsers": {
          "default": [],
          "description": "App users created at start-up when their username does not exist yet (and was never seeded before).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Hashed (scrypt) when the user is seeded; it is never stored as written."
              },
              "email": {
                "type": "string",
                "maxLength": 254
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "gender": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "extra": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "username",
              "password"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
