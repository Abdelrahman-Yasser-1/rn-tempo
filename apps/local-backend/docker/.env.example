# Copy to .env next to compose.yaml.
# The dashboard and the admin API:
TEMPO_DOMAIN=tempo.example.com
# The public APIs of the backends (/b/<id>/...). A different host on purpose.
TEMPO_API_DOMAIN=api.tempo.example.com
# Optional: days to keep the audit log (default 90).
TEMPO_AUDIT_DAYS=90
# Optional: use a published image instead of building: ghcr.io/<owner>/tempo-local-backend:<tag>
# TEMPO_IMAGE=
