{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "The main window: events from Rust, the folder and file pickers, and the app's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-node-info",
    "allow-list-recents",
    "allow-open-project",
    "allow-remove-recent",
    "allow-create-workspace",
    "allow-project-state",
    "allow-cli",
    "allow-control",
    "allow-subscribe-events",
    "allow-unsubscribe-events",
    "allow-list-booted-simulators",
    "allow-read-workspace",
    "allow-write-workspace",
    "allow-open-target",
    "allow-cert-status",
    "allow-list-backends",
    "allow-backend-status",
    "allow-pick-new-folder",
    "allow-create-backend",
    "allow-open-backend",
    "allow-remove-backend",
    "allow-start-backend",
    "allow-stop-backend",
    "allow-admin",
    "allow-try-it",
    "allow-cert-info",
    "allow-engine-cli",
    "allow-check-openapi",
    "allow-export-snapshot",
    "allow-restore-snapshot",
    "allow-list-simulators",
    "allow-reveal",
    "allow-open-docs",
    "allow-create-handler",
    "allow-engine-log",
    "allow-pick-import-file",
    "allow-save-export",
    "allow-upload-media",
    "allow-upload-dropped",
    "allow-media-preview",
    "allow-download-media",
    "allow-subscribe-requests",
    "allow-unsubscribe-requests"
  ]
}
