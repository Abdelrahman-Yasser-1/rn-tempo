{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "The main window: events from Rust and the app's own commands. File and folder dialogs are opened from Rust, so the webview has no dialog permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-backends",
    "allow-backend-status",
    "allow-pick-new-folder",
    "allow-create-backend",
    "allow-open-backend",
    "allow-remove-backend",
    "allow-start-backend",
    "allow-stop-backend",
    "allow-admin",
    "allow-try-it",
    "allow-cert-info",
    "allow-engine-cli",
    "allow-check-openapi",
    "allow-export-snapshot",
    "allow-restore-snapshot",
    "allow-list-simulators",
    "allow-reveal",
    "allow-open-docs",
    "allow-create-handler",
    "allow-engine-log",
    "allow-pick-import-file",
    "allow-pick-api-file",
    "allow-save-export",
    "allow-upload-media",
    "allow-upload-dropped",
    "allow-media-preview",
    "allow-download-media",
    "allow-subscribe-requests",
    "allow-unsubscribe-requests"
  ]
}
