",
  "src/features/orders/api/keys.ts": "/** Query keys of the orders feature. Keep them here so invalidation stays predictable. */
export const ordersKeys = {
  all: ['orders'] as const,
  list: () => [...ordersKeys.all, 'list'] as const,
  detail: (id: number) => [...ordersKeys.all, 'detail', id] as const,
  invoicesList: () => [...ordersKeys.all, 'invoices', 'list'] as const,
  invoicesDetail: (id: string) => [...ordersKeys.all, 'invoices', 'detail', id] as const,
};
",
  "src/features/orders/api/mutations.ts": "import { useMutation, useQueryClient } from '@tanstack/react-query';

import { ordersKeys } from './keys';
import { createInvoices, updateInvoices, deleteInvoices } from './orders.api';

/** Creates one invoices record and refreshes the cached orders data. */
export function useCreateInvoicesMutation() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: createInvoices,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ordersKeys.all });
    },
  });
}

/** Changes one invoices record and refreshes the cached orders data. */
export function useUpdateInvoicesMutation() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: updateInvoices,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ordersKeys.all });
    },
  });
}

/** Deletes one invoices record and refreshes the cached orders data. */
export function useDeleteInvoicesMutation() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: deleteInvoices,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ordersKeys.all });
    },
  });
}
",
  "src/features/orders/api/orders.api.ts": "import { request } from '@services/http/request';

import { InvoicesSchema, InvoicesPageSchema, type InvoicesInput } from './schemas';

/** \`GET /invoices\`: one page of invoices records. */
export function listInvoices({ skip = 0, limit = 20 }: Readonly<{ skip?: number; limit?: number }> = {}) {
  return request({ method: 'GET', url: '/invoices', params: { skip, limit } }, InvoicesPageSchema);
}

/** \`GET /invoices/:id\` */
export function getInvoices(id: string) {
  return request({ method: 'GET', url: \`/invoices/\${id}\` }, InvoicesSchema);
}

/** \`POST /invoices/add\` */
export function createInvoices(body: Readonly<InvoicesInput>) {
  return request({ method: 'POST', url: '/invoices/add', data: body }, InvoicesSchema);
}

/** \`PATCH /invoices/:id\` */
export function updateInvoices({ id, body }: Readonly<{ id: string; body: Partial<InvoicesInput> }>) {
  return request({ method: 'PATCH', url: \`/invoices/\${id}\`, data: body }, InvoicesSchema);
}

/** \`DELETE /invoices/:id\`: answers the removed record. */
export function deleteInvoices(id: string) {
  return request({ method: 'DELETE', url: \`/invoices/\${id}\` }, InvoicesSchema);
}
",
  "src/features/orders/api/queries.ts": "import { useQuery } from '@tanstack/react-query';

import { ORDERS_STALE_TIME_MS } from '@features/orders/constants';
import type { OrdersItem } from '@features/orders/types';

import { ordersKeys } from './keys';
import { listInvoices, getInvoices } from './orders.api';

/** Example fetcher: replace the body with a request through @services/http once the endpoint exists. */
function fetchOrdersList(): Promise<readonly OrdersItem[]> {
  return Promise.resolve([]);
}

/** Loads the list of orders items. */
export function useOrdersListQuery() {
  return useQuery({
    queryKey: ordersKeys.list(),
    queryFn: fetchOrdersList,
    staleTime: ORDERS_STALE_TIME_MS,
  });
}

/** One page of invoices records. */
export function useInvoicesListQuery() {
  return useQuery({ queryKey: ordersKeys.invoicesList(), queryFn: () => listInvoices() });
}

/** One invoices record by id. */
export function useInvoicesQuery(id: string) {
  return useQuery({ queryKey: ordersKeys.invoicesDetail(id), queryFn: () => getInvoices(id) });
}
",
  "src/features/orders/api/schemas.ts": "import { z } from 'zod';

/** One invoices record. Replace the stub with the real fields. */
export const InvoicesSchema = z.object({ id: z.number(), title: z.string() });
export type Invoices = z.infer<typeof InvoicesSchema>;

/** What a client sends to create or change one invoices record: the record without its id. */
export const InvoicesInputSchema = InvoicesSchema.omit({ id: true });
export type InvoicesInput = z.infer<typeof InvoicesInputSchema>;

/** A page of invoices records, as \`GET /invoices?limit=&skip=\` answers. */
export const InvoicesPageSchema = z.object({
  invoices: z.array(InvoicesSchema),
  total: z.number(),
  skip: z.number(),
  limit: z.number(),
});
export type InvoicesPage = z.infer<typeof InvoicesPageSchema>;
",
}
`;

