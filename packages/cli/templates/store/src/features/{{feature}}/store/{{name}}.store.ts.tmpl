import { create } from 'zustand';

type {{Name}}State = {
  count: number;
  increment: () => void;
  reset: () => void;
};

/** Client state of the {{name}} store. Server data belongs in TanStack Query, not here. */
export const use{{Name}}Store = create<{{Name}}State>()((set) => ({
  count: 0,
  increment: () => {
    set((state) => ({ count: state.count + 1 }));
  },
  reset: () => {
    set({ count: 0 });
  },
}));
