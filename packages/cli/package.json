{
  "name": "create-tempo-app",
  "version": "0.0.0",
  "description": "Create RN-TEMPO React Native apps and manage them with the tempo CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-tempo-app": "dist/create.mjs",
    "tempo": "dist/tempo.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-Yasser-1/rn-tempo.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@rn-tempo/contracts": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "citty": "0.2.2",
    "execa": "10.2.1",
    "giget": "3.3.1",
    "magicast": "0.5.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
