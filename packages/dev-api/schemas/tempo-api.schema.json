{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "basePath": {
      "description": "Mounted in front of every path, for example `/api/v1`.",
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "seed": {
      "description": "Seed of the data generator.",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id, for example `get.products.:id`. Scenarios and fixtures use it."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^\\/",
            "description": "Express-style path with `:param` segments, for example `/products/:id`."
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth": {
            "type": "string",
            "const": "bearer"
          },
          "request": {
            "type": "object",
            "properties": {
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "A JSON Schema (draft 2020-12)."
              },
              "query": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "A JSON Schema (draft 2020-12)."
              },
              "body": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "A JSON Schema (draft 2020-12)."
              }
            },
            "additionalProperties": false
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "schema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "A JSON Schema (draft 2020-12)."
              },
              "example": {
                "description": "Served as the response body. Without it, data is generated from `schema`."
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "scenarios": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "delayMs": {
                  "description": "Wait this long before answering.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "body": {
                  "description": "Sent as the JSON body instead of the normal response."
                }
              },
              "additionalProperties": false,
              "description": "A canned response, like a scenario in a code config."
            }
          }
        },
        "required": [
          "id",
          "method",
          "path",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "endpoints"
  ],
  "additionalProperties": false,
  "title": "tempo-api workspace",
  "description": "A RN-TEMPO dev API described as JSON."
}
