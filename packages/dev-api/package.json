    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "4.6.7"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@rn-tempo/api-contract": "workspace:*"
  },
  "devDependencies": {
    "@rn-tempo/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
