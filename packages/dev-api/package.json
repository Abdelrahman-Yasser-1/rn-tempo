    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "4.6.7"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@rn-tempo/api-contract": "workspace:*",
    "citty": "0.2.2",
    "express": "5.3.0",
    "jiti": "2.7.0",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@rn-tempo/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
