{
  "name": "@rn-tempo/dev-api",
  "version": "0.0.0",
  "description": "RN-TEMPO dev API: a local mock server with seeded data, scenarios and generated docs, started with the tempo-api command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tempo-api": "dist/tempo-api.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-Yasser-1/rn-tempo.git",
    "directory": "packages/dev-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
