{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@rn-tempo/contracts/schemas/feature-manifest.schema.json",
  "title": "RN-TEMPO feature manifest",
  "description": "Describes an optional template module and how `tempo feature remove` strips it (contract C7.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "description", "defaultEnabled", "requires", "conflicts", "deleteGlobs", "dependencies", "devDependencies", "envKeys", "jsonPatches", "postRemove", "docs"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "$ref": "#/$defs/featureName" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "defaultEnabled": { "type": "boolean" },
    "requires": { "type": "array", "items": { "$ref": "#/$defs/featureName" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/featureName" }, "uniqueItems": true },
    "deleteGlobs": { "type": "array", "items": { "type": "string", "minLength": 1, "not": { "pattern": "^(/|\\.\\./)" } }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "devDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "envKeys": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
    "jsonPatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "op", "path"],
        "properties": {
          "file": { "type": "string", "pattern": "\\.json$" },
          "op": { "const": "remove" },
          "path": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "postRemove": { "type": "array", "items": { "enum": ["pods", "assets-sync"] }, "uniqueItems": true },
    "docs": { "type": "string", "pattern": "^/docs/" }
  },
  "$defs": {
    "featureName": {
      "enum": ["ssl-pinning", "device-integrity", "storybook", "dynamic-forms", "samples", "maestro", "ci-github", "ai-claude", "ai-cursor", "ai-copilot"]
    }
  }
}
