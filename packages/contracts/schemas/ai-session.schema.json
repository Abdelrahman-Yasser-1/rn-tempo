{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@rn-tempo/contracts/schemas/ai-session.schema.json",
  "title": "RN-TEMPO AI session log frontmatter",
  "description": "Frontmatter of .ai/sessions/<file>.md written by scripts/ai-log (contract C9).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tool", "model", "author", "branch", "spec", "started", "ended", "commits", "files"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{4}-[a-z-]+-[a-z0-9]{6}$" },
    "tool": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "branch": { "type": ["string", "null"] },
    "spec": { "type": ["string", "null"] },
    "started": { "type": "string", "format": "date-time" },
    "ended": { "type": ["string", "null"], "format": "date-time" },
    "commits": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" } },
    "files": { "type": "array", "items": { "type": "string" } }
  }
}
