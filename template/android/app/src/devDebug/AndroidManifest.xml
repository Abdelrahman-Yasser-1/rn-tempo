<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the devDebug variant merges this file. It points the app at the network security config
         next to it, which trusts user-installed CAs (the local mkcert CA). Nothing else changes in
         <application>: the main manifest's attributes still apply. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
