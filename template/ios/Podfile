# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# Maps each per-environment build configuration to a CocoaPods build type.
# Keep in sync with the configurations created by scripts/native/ios-envs.rb (yarn ios:envs).
project 'TempoApp',
        'Debug-Dev' => :debug, 'Release-Dev' => :release,
        'Debug-Staging' => :debug, 'Release-Staging' => :release,
        'Debug-Prod' => :debug, 'Release-Prod' => :release
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
# @tempo-feature:firebase-core:start
# React Native Firebase 27 gets the Firebase SDK through Swift Package Manager, which needs dynamic
# frameworks (static linkage fails at `pod install`). Set USE_FRAMEWORKS=static only after removing the firebase-core module.
linkage ||= 'dynamic'
# @tempo-feature:firebase-core:end
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TempoApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # @tempo-feature:firebase-core:start
    # Dynamic frameworks must link every system framework their code uses. react-native-image-picker
    # calls UTType functions of MobileCoreServices and UniformTypeIdentifiers but its podspec declares neither,
    # which a static build hid. Only the file-picker module uses this pod; remove this block with the module.
    installer.pods_project.targets.each do |pod_target|
      next unless pod_target.name == 'react-native-image-picker'

      pod_target.build_configurations.each do |build_config|
        build_config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)', '-framework', 'MobileCoreServices', '-framework', 'UniformTypeIdentifiers']
      end
    end
    # @tempo-feature:firebase-core:end

    # Some pods (TrustKit, SDWebImage resource bundles) still declare a deployment target below what
    # current Xcode SDKs support, which fails the build. Raise them to the app's minimum.
    min_version = Gem::Version.new(min_ios_version_supported)
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < min_version
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_version.to_s
        end
      end
    end
  end
end
