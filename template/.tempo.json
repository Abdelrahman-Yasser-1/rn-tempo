{
  "$schema": "https://unpkg.com/@rn-tempo/contracts/schemas/tempo.schema.json",
  "templateVersion": "0.0.0",
  "createdWith": "create-tempo-app@0.0.0",
  "app": {
    "name": "TempoApp",
    "displayName": "Tempo",
    "bundleId": "com.rntempo.app"
  },
  "envs": [
    {
      "name": "dev",
      "suffix": ".dev",
      "displayName": "Tempo Dev",
      "scheme": "tempo-dev",
      "badge": "DEV"
    },
    {
      "name": "staging",
      "suffix": ".staging",
      "displayName": "Tempo Stg",
      "scheme": "tempo-staging",
      "badge": "STG"
    },
    {
      "name": "prod",
      "suffix": "",
      "displayName": "Tempo",
      "scheme": "tempo",
      "badge": null
    }
  ],
  "features": [
    "ai-claude",
    "ai-copilot",
    "ai-cursor",
    "ai-vendored-skills",
    "app-icons",
    "ci-github",
    "cms",
    "crashlytics",
    "device-integrity",
    "dynamic-forms",
    "file-picker",
    "firebase-core",
    "maestro",
    "maps",
    "push-notifications",
    "samples",
    "ssl-pinning",
    "storybook",
    "webview"
  ],
  "ai": {
    "tools": [
      "claude",
      "copilot",
      "cursor"
    ],
    "logPrompts": "full"
  }
}
