{
  "$schema": "https://unpkg.com/@rn-tempo/contracts/schemas/feature-manifest.schema.json",
  "name": "dynamic-forms",
  "title": "Config-driven forms",
  "description": "Multi-step forms rendered from config with a field registry, visibility rules and zod validation.",
  "defaultEnabled": false,
  "requires": [],
  "conflicts": [],
  "deleteGlobs": [
    "src/shared/components/DynamicForm/**",
    "src/app/bootstrap/initFormDrafts.ts",
    "src/app/bootstrap/initFormDrafts.test.ts",
    "specs/dynamic-forms/**"
  ],
  "dependencies": [],
  "devDependencies": [],
  "envKeys": [],
  "jsonPatches": [
    {
      "file": "src/locales/en/common.json",
      "op": "remove",
      "path": "/formBuilder"
    },
    {
      "file": "src/locales/ar/common.json",
      "op": "remove",
      "path": "/formBuilder"
    },
    {
      "file": "src/locales/en/validation.json",
      "op": "remove",
      "path": "/formBuilder"
    },
    {
      "file": "src/locales/ar/validation.json",
      "op": "remove",
      "path": "/formBuilder"
    },
    {
      "file": "src/locales/en/app.json",
      "op": "remove",
      "path": "/debug/forms"
    },
    {
      "file": "src/locales/ar/app.json",
      "op": "remove",
      "path": "/debug/forms"
    },
    {
      "file": "src/locales/en/app.json",
      "op": "remove",
      "path": "/formsDemo"
    },
    {
      "file": "src/locales/ar/app.json",
      "op": "remove",
      "path": "/formsDemo"
    }
  ],
  "postRemove": [],
  "docs": "/docs/features/dynamic-forms"
}
