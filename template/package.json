{
  "name": "tempo-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native run-android --mode devDebug --appIdSuffix dev",
    "android:staging": "react-native run-android --mode stagingDebug --appIdSuffix staging",
    "android:prod": "react-native run-android --mode prodDebug",
    "android:dev:release": "cd android && ./gradlew assembleDevRelease",
    "android:staging:release": "cd android && ./gradlew assembleStagingRelease",
    "android:prod:release": "cd android && ./gradlew assembleProdRelease",
    "android:dev:bundle": "cd android && ./gradlew bundleDevRelease",
    "android:staging:bundle": "cd android && ./gradlew bundleStagingRelease",
    "android:prod:bundle": "cd android && ./gradlew bundleProdRelease",
    "ios": "react-native run-ios",
    "ios:dev": "react-native run-ios --scheme TempoApp-Dev --mode Debug-Dev",
    "ios:staging": "react-native run-ios --scheme TempoApp-Staging --mode Debug-Staging",
    "ios:prod": "react-native run-ios --scheme TempoApp-Prod --mode Debug-Prod",
    "ios:envs": "bundle exec ruby scripts/native/ios-envs.rb --project ios/TempoApp.xcodeproj --target TempoApp --envs dev:Dev,staging:Staging,prod:Prod",
    "pods": "cd ios && bundle exec pod install",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:files": "ls-lint",
    "lint:deadcode": "knip",
    "i18n:check": "i18next-cli lint && i18next-cli extract --ci",
    "icons": "node scripts/native/icons.mjs",
    "assets:sync": "node scripts/assets-sync.mjs",
    "test:assets-sync": "node --test scripts/__tests__/assets-sync.test.mjs",
    "start": "react-native start",
    "start:dev": "react-native start",
    "start:staging": "react-native start",
    "start:prod": "react-native start",
    "storybook": "STORYBOOK_ENABLED=true react-native start",
    "storybook:generate": "sb-rn-get-stories",
    "test": "jest",
    "ai:start": "node scripts/ai-log/session-start.mjs",
    "ai:prompt": "node scripts/ai-log/prompt.mjs",
    "ai:stop": "node scripts/ai-log/session-stop.mjs",
    "ai:report": "node scripts/ai-log/report.mjs",
    "test:ai-log": "node --test \"scripts/ai-log/__tests__/*.test.mjs\"",
    "ai:sync": "node scripts/ai-sync/sync.mjs",
    "test:ai-sync": "node --test \"scripts/ai-sync/__tests__/*.test.mjs\"",
    "spec:check": "node scripts/spec-check.mjs",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn lint:files && yarn i18n:check && yarn test --ci",
    "verify:changed": "node scripts/verify-changed.mjs"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "6.0.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/normalize-colors": "0.88.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "5.104.5",
    "axios": "1.20.0",
    "i18next": "26.5.6",
    "jail-monkey": "3.0.0",
    "react": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.3",
    "react-native": "0.88.0",
    "react-native-bootsplash": "7.3.4",
    "react-native-config": "1.7.2",
    "react-native-edge-to-edge": "1.8.2",
    "react-native-fast-shimmer": "1.3.5",
    "react-native-gesture-handler": "3.4.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-restart": "0.0.29",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-ssl-public-key-pinning": "1.2.6",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "2.5.2",
    "react-native-unistyles": "3.6.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@commitlint/cli": "21.2.4",
    "@ls-lint/ls-lint": "2.3.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@rn-tempo/commitlint-config": "link:../packages/commitlint-config",
    "@rn-tempo/eslint-config": "link:../packages/eslint-config",
    "@rn-tempo/prettier-config": "link:../packages/prettier-config",
    "@rn-tempo/tsconfig": "link:../packages/tsconfig",
    "@rozenite/metro": "2.5.0",
    "@rozenite/mmkv-plugin": "2.1.0",
    "@rozenite/network-activity-plugin": "2.5.0",
    "@rozenite/tanstack-query-plugin": "2.5.0",
    "@storybook/addon-ondevice-actions": "10.7.0",
    "@storybook/addon-ondevice-controls": "10.7.0",
    "@storybook/react-native": "10.7.0",
    "@testing-library/react-native": "14.1.0",
    "@types/fast-text-encoding": "1.0.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "danger": "14.0.7",
    "eslint": "10.13.0",
    "fast-text-encoding": "1.0.6",
    "i18next-cli": "1.80.0",
    "jest": "30.5.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "react-native-svg-transformer": "1.5.3",
    "react-native-url-polyfill": "4.0.0",
    "sharp": "0.35.5",
    "storybook": "10.6.3",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "yarn@4.18.1"
}
