{
  "extends": ["@react-native/typescript-config", "@rn-tempo/tsconfig/base.json"],
  "compilerOptions": {
    // Path aliases (contract C4). The single source: babel.config.js, jest.config.js and ESLint read these.
    "paths": {
      "@app/*": ["./src/app/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@services/*": ["./src/services/*"],
      "@theme/*": ["./src/theme/*"],
      "@assets/*": ["./src/assets/*"],
      "@locales/*": ["./src/locales/*"],
      "@config/*": ["./src/config/*"],
      "@test-utils/*": ["./src/test-utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".rnstorybook/**/*.ts", ".rnstorybook/**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios", "vendor"]
}
