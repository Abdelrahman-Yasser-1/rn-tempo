{
  "extends": "@rn-tempo/tsconfig/react-native.json",
  "compilerOptions": {
    // Path aliases: keep in sync with babel.config.js (contract C4).
    "paths": {
      "@app/*": ["./src/app/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@services/*": ["./src/services/*"],
      "@theme/*": ["./src/theme/*"],
      "@assets/*": ["./src/assets/*"],
      "@locales/*": ["./src/locales/*"],
      "@config/*": ["./src/config/*"],
      "@test-utils/*": ["./src/test-utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios", "vendor"]
}
