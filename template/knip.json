{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.js",
    "src/app/App.tsx",
    "src/app/providers/DevTools.tsx",
    "src/**/index.ts",
    "src/assets/icons.keep.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["babel-jest"],
  "ignoreBinaries": ["tempo", "adb"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/navigation/types.ts": ["types"],
    "src/config/env.ts": ["exports"]
  }
}
