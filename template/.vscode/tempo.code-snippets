{
  "React Native component": {
    "prefix": "rncomp",
    "description": "Component file (PascalCase file name). Add styles.ts, types.ts and index.ts next to it.",
    "body": [
      "import { View } from 'react-native';",
      "",
      "import { styles } from './styles';",
      "import type { ${TM_FILENAME_BASE}Props } from './types';",
      "",
      "export function ${TM_FILENAME_BASE}({ testID }: Readonly<${TM_FILENAME_BASE}Props>) {",
      "  return (",
      "    <View testID={testID} style={styles.container}>",
      "      $0",
      "    </View>",
      "  );",
      "}",
    ],
  },
  "React Native screen": {
    "prefix": "rnscreen",
    "description": "Screen component with i18n and the screen testID convention",
    "body": [
      "import { View } from 'react-native';",
      "import { useTranslation } from 'react-i18next';",
      "",
      "import { styles } from './styles';",
      "",
      "export function ${TM_FILENAME_BASE}() {",
      "  const { t } = useTranslation('${1:namespace}');",
      "",
      "  return (",
      "    <View testID=\"${2:name}-screen\" style={styles.container}>",
      "      $0",
      "    </View>",
      "  );",
      "}",
    ],
  },
  "React Native hook": {
    "prefix": "rnhook",
    "description": "Custom hook (file use<Name>.ts)",
    "body": [
      "import { useCallback, useState } from 'react';",
      "",
      "export function ${TM_FILENAME_BASE}() {",
      "  const [${1:value}, set${1/(.*)/${1:/capitalize}/}] = useState<${2:string}>(${3:''});",
      "",
      "  const reset = useCallback(() => {",
      "    set${1/(.*)/${1:/capitalize}/}(${3:''});",
      "  }, []);",
      "",
      "  return { ${1:value}, set${1/(.*)/${1:/capitalize}/}, reset };",
      "}",
    ],
  },
  "TanStack Query hook": {
    "prefix": "rnquery",
    "description": "useQuery hook with a typed key factory",
    "body": [
      "import { useQuery } from '@tanstack/react-query';",
      "",
      "export const ${1:items}Keys = {",
      "  all: ['${1:items}'] as const,",
      "  detail: (id: string) => [...${1:items}Keys.all, id] as const,",
      "};",
      "",
      "export function use${2:Item}(id: string) {",
      "  return useQuery({",
      "    queryKey: ${1:items}Keys.detail(id),",
      "    queryFn: () => ${3:fetchItem}(id),",
      "  });",
      "}",
    ],
  },
  "Zustand store": {
    "prefix": "rnstore",
    "description": "Zustand store (file <name>.store.ts)",
    "body": [
      "import { create } from 'zustand';",
      "",
      "type ${1:Counter}State = {",
      "  ${2:count}: number;",
      "  increment: () => void;",
      "  reset: () => void;",
      "};",
      "",
      "export const use${1:Counter}Store = create<${1:Counter}State>()((set) => ({",
      "  ${2:count}: 0,",
      "  increment: () => set((state) => ({ ${2:count}: state.${2:count} + 1 })),",
      "  reset: () => set({ ${2:count}: 0 }),",
      "}));",
    ],
  },
  "React Native test": {
    "prefix": "rntest",
    "description": "RNTL test. Spec'd features name tests AC-n: ...",
    "body": [
      "import { render, screen } from '@testing-library/react-native';",
      "",
      "import { ${1:Component} } from './${1:Component}';",
      "",
      "describe('${1:Component}', () => {",
      "  test('AC-${2:1}: ${3:renders}', async () => {",
      "    await render(<${1:Component} testID=\"${4:component}\" />);",
      "",
      "    expect(screen.getByTestId('${4:component}')).toBeOnTheScreen();",
      "  });",
      "});",
    ],
  },
}
