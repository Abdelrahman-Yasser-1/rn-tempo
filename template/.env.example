# Copy to .env.<env> (dev | staging | prod). Validated at startup by src/config/env.ts.
APP_ENV=dev
API_BASE_URL=https://dummyjson.com
API_TIMEOUT_MS=15000
API_MOCKING=true
SSL_PINNING_ENABLED=false
SSL_PINS=
DEVICE_INTEGRITY_ENABLED=false
STORYBOOK_ENABLED=false
DEEP_LINK_SCHEME=tempo-dev
DEEP_LINK_HOST=
APP_CONFIG_PATH=/app-config
LOG_LEVEL=debug
# Crash reports for this environment: CRASH_REPORTER is none or crashlytics. Staging and prod: true. Dev: false.
# Debug builds never report, whatever these say.
CRASH_REPORTING_ENABLED=false
CRASH_REPORTER=none
# @tempo-feature:firebase-core:start
# Firebase for this environment: copies firebase/<env>/ config files into the build and lets Firebase-backed
# services start. Staging and prod: true, with their own Firebase project. Dev: false until you add files.
FIREBASE_ENABLED=false
# @tempo-feature:firebase-core:end
# @tempo-feature:push-notifications:start
# Push notifications for this environment (needs FIREBASE_ENABLED=true). Staging and prod: true. Dev: false.
PUSH_ENABLED=false
# @tempo-feature:push-notifications:end
# @tempo-feature:maps:start
# Google Maps API key, Android only (iOS uses Apple Maps and needs none). Empty draws blank map tiles.
GOOGLE_MAPS_API_KEY=
# @tempo-feature:maps:end
