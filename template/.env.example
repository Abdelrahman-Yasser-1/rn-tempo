# Copy to .env.<env> (dev | staging | prod). Validated at startup by src/config/env.ts.
APP_ENV=dev
API_BASE_URL=https://dummyjson.com
API_TIMEOUT_MS=15000
API_MOCKING=true
SSL_PINNING_ENABLED=false
SSL_PINS=
DEVICE_INTEGRITY_ENABLED=false
STORYBOOK_ENABLED=false
DEEP_LINK_SCHEME=tempo-dev
DEEP_LINK_HOST=
APP_CONFIG_PATH=/app-config
LOG_LEVEL=debug
# @tempo-feature:maps:start
# Google Maps API key, Android only (iOS uses Apple Maps and needs none). Empty draws blank map tiles.
GOOGLE_MAPS_API_KEY=
# @tempo-feature:maps:end
