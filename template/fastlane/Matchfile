# Code signing certificates and profiles live in an encrypted private git repo (MATCH_GIT_URL).
# CI runs match in readonly mode (see `setup_ci`); create or renew profiles locally with
# `bundle exec fastlane match <type>` by someone who owns the signing repo.
git_url(ENV.fetch("MATCH_GIT_URL", ""))
storage_mode("git")
type("appstore")
app_identifier(%w[com.rntempo.app com.rntempo.app.staging com.rntempo.app.dev])
